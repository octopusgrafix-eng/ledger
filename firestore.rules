rules_version = '2';

// Job Ledger — Firestore security rules
//
// Each signed-in user's entire ledger lives in ONE document whose id is their auth uid:
//     ledgerData/{uid}
//
// The rule below says: you may read or write that document only if you are signed in
// AND the document id matches your own uid. So even though the project id and API key
// are visible in the public page source, nobody can reach your books without your
// email and password — and no signed-in user can reach anyone else's.
//
// Anything not matched below is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    match /ledgerData/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

  }
}
